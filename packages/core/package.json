{
  "name": "@react-doctor/core",
  "version": "0.1.0",
  "description": "Core analysis engine and shared types for React Doctor.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
