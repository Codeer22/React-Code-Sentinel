{
  "name": "@react-code-sentinel/react-rules",
  "version": "0.1.0",
  "description": "React-specific diagnostic rules for React Code Sentinel.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@react-code-sentinel/core": "0.1.0",
    "@react-code-sentinel/analyzers": "0.1.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\""
  }
}

