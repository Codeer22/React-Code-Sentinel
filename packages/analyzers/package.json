{
  "name": "@react-doctor/analyzers",
  "version": "0.1.0",
  "description": "Project and AST analyzers for React Doctor.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\""
  },
  "dependencies": {
    "@react-doctor/core": "0.1.0",
    "@typescript/typescript6": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  }
}
